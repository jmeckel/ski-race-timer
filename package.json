{
  "name": "chrono-race-timer",
  "version": "5.28.4",
  "description": "Precision race timing, GPS-synchronized",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:prod": "TEST_ENV=production playwright test",
    "test:e2e:prod:headed": "TEST_ENV=production playwright test --headed",
    "test:all": "npm run test && npm run test:e2e",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "lint": "biome check src tests api",
    "lint:fix": "biome check --write src tests api",
    "format": "biome format --write src tests api",
    "docs:pdf": "bash docs/build-pdfs.sh",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@preact/signals-core": "^1.13.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "rollup-plugin-visualizer": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
